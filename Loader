    TweenService:Create(WIN, slideT, {
        Position = UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset + 40)
    }):Play()
    for _, obj in ipairs(SG:GetDescendants()) do
        if obj:IsA("GuiObject") then
            pcall(function()
                TweenService:Create(obj, fadeT, {
                    BackgroundTransparency=1, ImageTransparency=1, TextTransparency=1
