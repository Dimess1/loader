local function shield(tbl)
    local proxy  = {}
    local shadow = {}
    for k,v in pairs(tbl) do shadow[k] = v end
    return setmetatable(proxy, {
        __index    = function(_, k) return shadow[k] end,
        __newindex = function(_, k, v) shadow[k] = v end,
        __len      = function() return #shadow end,
        __metatable= false,
    })
end

local Loader = (function()
    local _exec  = loadstring
    local _fetch = function(u)
        local ok, res = pcall(function() return game:HttpGet(u) end)
        return ok and res or nil
    end

    local function buildUrl(...)
        local s = ""
        for _, p in ipairs({...}) do s = s .. p end
        return s
    end

    local BASE_PARTS = {
        "https://", "api.", "jnkie", ".com",
        "/api/v1/", "luascripts/", "public/"
    }
    local function base() return buildUrl(table.unpack(BASE_PARTS)) end

    local function verifyAndRun(hash, content)
        pcall(function()
            local computed = (HashLib and HashLib.sha256(content))
                          or (crypt and crypt.hash and crypt.hash(content))
                          or nil
            if computed and computed ~= hash then
                error("Hash mismatch")
            end
        end)
        local fn, loadErr = _exec(content)
        if not fn then error("Erro ao compilar script: " .. tostring(loadErr)) end
        return fn
    end

    return shield({
        base  = base,
        fetch = _fetch,
        run   = function(hash, path)
            local url     = base() .. path .. "/download"
            local content = _fetch(url)
            if not content or #content < 10 then
                error("Download falhou ou conteúdo vazio")
            end
            local fn = verifyAndRun(hash, content)
            task.wait(math.random(80, 220) / 1000)
            task.spawn(fn)
        end,
    })
end)()

